{
  "name": "mobrix",
  "version": "1.0.0",
  "private": true,
  "description": "ERP industrial para gestão de marcenarias",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "check": "node --check server.js && node --check public/app.js && node --check db/migrate.js && node --check scripts/ci-db-setup.js",
    "test": "npm run check",
    "db:migrate": "node db/migrate.js",
